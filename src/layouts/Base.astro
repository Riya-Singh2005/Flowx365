---
import '../styles/global.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import { site } from '../data/site';
import DemoDialog from '../components/DemoDialog.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Overrides the canonical path; section addresses point at the homepage. */
  canonicalPath?: string;
}

const { title = site.title, description = site.description, noindex = false, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: site.maker,
      email: site.salesEmail,
    },
    {
      '@type': 'SoftwareApplication',
      name: site.name,
      url: site.url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Android',
      description,
      publisher: { '@id': `${site.url}/#org` },
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0f1520" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FlowX365: Write it once." />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <DemoDialog />
    <script>
      import { sections } from '../data/sections';
      import { showSectionPath } from '../scripts/sections';

      // In-page links scroll to their section and show its own path
      // (/how-it-works) rather than a `#chain` fragment. The hrefs stay real
      // anchors, so without JavaScript they still work. Scrolling follows the
      // page's own scroll-behavior.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element | null)?.closest?.('a[href^="#"]');
        const id = link?.getAttribute('href')!.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ block: 'start' });
        showSectionPath(target.id);
        // Move keyboard focus where an anchor jump would: the skip link lands
        // on main; other targets only if they already take focus.
        if (target.id === 'main' && !target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        if (target.hasAttribute('tabindex')) target.focus({ preventScroll: true });
      });

      // Arriving with an old `#section` link: let the browser scroll there,
      // then show the section's path instead (or no fragment at all).
      if (location.hash) {
        const s = sections.find((x) => `#${x.id}` === location.hash);
        const tidy = () => history.replaceState(null, '', (s ? `/${s.slug}` : location.pathname) + location.search);
        if (document.readyState === 'complete') tidy();
        else addEventListener('load', tidy, { once: true });
      }
    </script>
  </body>
</html>
