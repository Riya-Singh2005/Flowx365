---
import { terms } from '../../data/pricing';
---

<!-- The back of the rate card: how billing, GST and the trial work today. -->
<section class="sheet terms" id="terms" data-copy="triplicate" data-nav="light" aria-labelledby="terms-title" tabindex="-1">
  <span class="perf" aria-hidden="true" style="--hole: var(--duplicate)"></span>
  <div class="stub" aria-hidden="true"><span class="serial">Terms</span></div>

  <div class="sheet-inner">
    <div class="head">
      <h2 class="display-m" id="terms-title" data-reveal="mask">The terms.</h2>
      <p class="lede" data-reveal style="--i: 1">How billing, GST and your trial work today.</p>
    </div>

    <dl class="list">
      {
        terms.map((t, i) => (
          <div class="term" data-reveal style={`--i: ${i % 3}`}>
            <dt>{t.title}</dt>
            <dd class="text">{t.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .terms {
    position: relative;
    z-index: 1;
    padding: var(--sheet-pad) 0;
  }

  .terms:focus {
    outline: none;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: 0.75rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    max-width: 84rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .head .display-m {
    font-size: var(--sheet-title);
  }

  .head .lede {
    color: var(--ink-2);
    font-size: var(--step-0);
  }

  /* Conditions on the back of a bill: three short columns. */
  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 3rem);
    border-top: 2px solid var(--ink);
    max-width: 84rem;
  }

  .term {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule-strong);
  }

  dt {
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    line-height: 1.3;
  }

  .text {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  @media (max-width: 1080px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
