---
import Icon from '../ui/Icon.astro';
import ProductDialog from './ProductDialog.astro';
import {
  plans,
  everyPlan,
  formatPrice,
  CTA_LABEL,
  PRICE_PERIOD_LABELS,
  GST_LINE,
  TRIAL_LABEL,
  TRIAL_LINE,
} from '../../data/pricing';

// Enterprise lists its products as rows that open the shared product dialog.
const modalPlan = plans.find((p) => p.presentation === 'modal');
---

<!-- Three Original White rate sheets on the navy desk. The billing switch is
     two radios and needs no script. -->
<section class="plans" id="plans" data-nav="dark" aria-labelledby="plans-title" tabindex="-1">
  <h2 class="visually-hidden" id="plans-title">Plans and prices</h2>

  <div class="bar" data-reveal>
    <fieldset class="billing">
      <legend class="visually-hidden">Billing period</legend>
      <label><input type="radio" name="billing" id="bill-monthly" value="monthly" checked />Monthly</label>
      <label><input type="radio" name="billing" id="bill-annual" value="annual" />Annual</label>
    </fieldset>
    <p class="trial">
      <strong class="trial-label form-head">{TRIAL_LABEL}</strong>
      <span class="trial-line">{TRIAL_LINE}</span>
    </p>
  </div>

  <ol class="sheets">
    {
      plans.map((p, i) => (
        <li
          class:list={['rate', { recommended: p.recommended }]}
          data-tint={p.copy}
          data-reveal
          style={`--i: ${i + 1}`}
        >
          <span class="perf" aria-hidden="true" />
          <div class="rate-body">
            <header class="rate-head">
              <h3 class="rate-name form-head" id={`plan-${p.id}`}>
                {p.name}
              </h3>
              <div class="audience-row">
                <p class="audience">{p.audience}</p>
                {p.recommended && <p class="stamp form-head">Recommended</p>}
              </div>
              <p class="positioning">{p.positioning}</p>
            </header>

            <div class="price">
              <div class="price-summary">
                <div class="when-monthly">
                  <p class="amount">
                    <span class="num">{formatPrice(p.monthly)}</span>
                    <span class="per">{PRICE_PERIOD_LABELS.monthly}</span>
                  </p>
                </div>
                <div class="when-annual">
                  <p class="amount">
                    <span class="num">{formatPrice(p.annual)}</span>
                    <span class="per">{PRICE_PERIOD_LABELS.annual}</span>
                  </p>
                </div>
                <p class="serial gst-note">{GST_LINE}</p>
                <p class="serial cycle when-annual">Billed once a year</p>
              </div>
              <div class="plan-limits" aria-label="Included plan capacity">
                <p class="limit">
                  <Icon name="users" size={18} />
                  {p.usersLabel}
                </p>
                <p class="limit">
                  <Icon name="building" size={18} />
                  {p.companiesLabel}
                </p>
              </div>
            </div>

            <div class="includes">
              {p.presentation === 'modal' ? (
                <ul class="product-links" aria-label={`Products in the ${p.name} plan`}>
                  {p.products.map((product) => (
                    <li>
                      <button
                        class="product-link"
                        type="button"
                        data-product-open={product.id}
                        aria-haspopup="dialog"
                        aria-controls="product-dialog"
                      >
                        <span class="product-link-text">
                          <span class="product-link-name form-head">{product.name}</span>
                          <span class="product-link-meta">
                            {product.modules.length} modules · View details
                          </span>
                        </span>
                        <Icon name="arrow-right" size={18} />
                      </button>
                    </li>
                  ))}
                </ul>
              ) : (
              <div class="products">
                {p.products.map((product) => {
                  const productTitleId = `${p.id}-${product.id}-title`;
                  return (
                    <section class="product" data-product-accordion aria-labelledby={productTitleId}>
                      <h4 class="product-name form-head" id={productTitleId}>{product.name}</h4>
                      <div class="modules">
                        {product.modules.map((module) => {
                          const triggerId = `${p.id}-${product.id}-${module.id}-trigger`;
                          const panelId = `${p.id}-${product.id}-${module.id}-panel`;
                          return (
                            <div class="module-unit">
                              <button
                                class="module-trigger"
                                type="button"
                                id={triggerId}
                                aria-expanded="false"
                                aria-controls={panelId}
                              >
                                <span>{module.module}</span>
                                <Icon name="chevron" size={18} />
                              </button>
                              <div
                                class="module-panel"
                                id={panelId}
                                role="region"
                                aria-labelledby={triggerId}
                                aria-hidden="true"
                              >
                                <div class="module-panel-inner">
                                  {module.marketingDescription && (
                                    <p class="module-marketing">{module.marketingDescription}</p>
                                  )}
                                  {module.details.length > 0 && (
                                    <ul class="detail-list">
                                      {module.details.map((detail) => (
                                        <li>
                                          <Icon name="check" size={17} />
                                          <span>
                                            <strong>{detail.label}</strong>
                                          </span>
                                        </li>
                                      ))}
                                    </ul>
                                  )}
                                </div>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </section>
                  );
                })}
              </div>
              )}
            </div>

            <div class="counterfoil">
              <button class="btn" type="button" data-demo-trigger data-demo-plan={p.name}>
                {CTA_LABEL} <Icon name="arrow-right" />
                <span class="visually-hidden">for the {p.name} plan</span>
              </button>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="fine" data-reveal>
    <p class="every"><strong>Every plan:</strong> {everyPlan.join(', ')}.</p>
    <p class="fine-links">
      <a href="#terms">Where each term stands</a>
    </p>
  </div>

  {modalPlan && <ProductDialog planName={modalPlan.name} products={modalPlan.products} />}
</section>

<style>
  .plans {
    position: relative;
    background: var(--cover);
    color: var(--on-cover);
    padding: 0 var(--gutter) clamp(3rem, 5vw, 4.5rem);
  }

  .plans:focus {
    outline: none;
  }

  /* ── Billing switch ─────────────────────────────────────────── */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .billing {
    display: inline-flex;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .billing label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1.5px solid var(--cover-rule);
    color: var(--on-cover-2);
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 140ms var(--ease-out);
  }

  .billing label:first-of-type {
    border-radius: var(--radius-ui) 0 0 var(--radius-ui);
  }

  .billing label:last-of-type {
    border-radius: 0 var(--radius-ui) var(--radius-ui) 0;
    margin-left: -1.5px;
  }

  /* On navy the selected choice is the white top sheet, ink on paper. */
  .billing label:has(input:checked) {
    background: var(--original);
    border-color: var(--original);
    color: var(--ink);
    z-index: 1;
  }

  .billing label:active {
    transform: scale(0.97);
  }

  .billing input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .billing label:has(input:focus-visible) {
    outline: 2px solid var(--live);
    outline-offset: 3px;
    z-index: 2;
  }

  @media (hover: hover) and (pointer: fine) {
    .billing label:not(:has(input:checked)):hover {
      color: var(--on-cover);
      border-color: rgb(247 248 250 / 0.4);
    }
  }

  /* The trial, ruled in canary like the last line of the cover: offered, and
     arranged through the demo request rather than a sign-up button. */
  .trial {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    margin-left: auto;
    padding: 0.5rem 1.25rem;
    border: 1.5px solid var(--triplicate);
    border-radius: var(--radius-ui);
    text-align: center;
  }

  /* Line one: the offer, in canary caps. */
  .trial-label {
    display: block;
    color: var(--triplicate);
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  /* Line two: how to get it, smaller and quieter. */
  .trial-line {
    display: block;
    color: var(--on-cover-2);
    font-size: 0.8125rem;
    line-height: 1.3;
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
  }

  /* The switch shows either the monthly or the yearly figures on every sheet. */
  .when-annual {
    display: none;
  }

  .plans:has(#bill-annual:checked) .when-annual {
    display: block;
  }

  .plans:has(#bill-annual:checked) .when-monthly {
    display: none;
  }

  /* ── The rate sheets ────────────────────────────────────────── */
  .sheets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2vw, 2rem);
    align-items: stretch;
    max-width: 92rem;
  }

  .rate {
    --paper: var(--original);
    --hole: var(--cover);
    --ink-3: #5b6472;
    position: relative;
    display: flex;
    background: var(--paper);
    color: var(--ink);
    border-radius: 3px;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.12),
      0 30px 60px -24px rgb(0 0 0 / 0.55);
    container-type: inline-size;
    transition:
      translate 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  /* The recommended sheet keeps its place in line (tops align across the set);
     the stamp and a deeper shadow mark it. */
  .rate.recommended {
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.12),
      0 40px 70px -24px rgb(0 0 0 / 0.65);
  }

  @media (hover: hover) and (pointer: fine) {
    .rate:hover {
      translate: 0 -0.25rem;
    }
  }

  .rate-body {
    display: flex;
    flex-direction: column;
    width: 100%;
    --pad: clamp(1.25rem, 1.8vw, 1.75rem);
    padding: var(--pad);
  }

  .rate-head {
    position: relative;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
  }

  /* The audience line, with the Recommended stamp struck at its end. */
  .audience-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.75rem;
    margin-top: 0.4rem;
  }

  .audience-row .audience {
    margin-top: 0;
  }

  .audience-row .stamp {
    margin-block: 0.1rem 0.2rem;
  }

  /* Sized to the sheet, so PROFESSIONAL never runs off its paper. */
  .rate-name {
    font-size: min(2rem, 7cqi);
    font-weight: var(--weight-heavy);
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .audience {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
  }

  /* A rubber stamp, struck slightly askew in ink. */
  .stamp {
    flex: none;
    padding: 0.2rem 0.5rem;
    border: 2px solid var(--ink);
    border-radius: 3px;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--ink);
    rotate: -4deg;
  }

  .price {
    padding: 1rem 0 0.75rem;
  }

  .price-summary {
    min-width: 0;
  }

  .amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
  }

  .amount .num {
    font-size: clamp(2.5rem, 1.8rem + 2vw, 3.5rem);
    font-weight: var(--weight-heavy);
    font-variation-settings: 'wdth' var(--wdth-head);
    letter-spacing: var(--track-display);
    line-height: 0.95;
  }

  .per {
    color: var(--ink-3);
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
    white-space: nowrap;
  }

  .gst-note {
    margin-top: 0.45rem;
    color: var(--ink-3);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
  }

  .cycle {
    margin-top: 0.25rem;
    color: var(--ink-3);
  }

  /* Who the plan is for, in people: a ruled tag in ink, easy to find. */
  .plan-limits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .limit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    font-weight: var(--weight-bold);
    font-variation-settings: 'wdth' var(--wdth-ui);
    font-size: 1rem;
    line-height: 1.2;
  }

  .positioning {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .includes {
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }

  .products {
    display: grid;
    gap: 0.8rem;
  }

  .product + .product {
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule-strong);
  }

  .product-name {
    margin-bottom: 0.45rem;
    font-size: 0.8125rem;
    font-weight: var(--weight-heavy);
    font-variation-settings: 'wdth' var(--wdth-caps);
    letter-spacing: 0.045em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .modules {
    display: grid;
    gap: 0.35rem;
  }

  .module-unit {
    overflow: hidden;
    border: 1px solid rgb(17 24 39 / 0.26);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.14);
  }

  .module-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    font-variation-settings: 'wdth' var(--wdth-ui);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 140ms var(--ease-out);
  }

  .module-trigger:active {
    transform: scale(0.99);
  }

  .module-trigger:focus-visible {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--live);
    outline-offset: -3px;
  }

  .module-trigger[aria-expanded='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .module-trigger :global(svg) {
    flex: none;
    transition: transform 180ms var(--ease-out);
  }

  .module-trigger[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .module-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-2px);
    pointer-events: none;
    transition:
      grid-template-rows 180ms var(--ease-out),
      opacity 140ms ease,
      transform 180ms var(--ease-out);
  }

  .module-trigger[aria-expanded='true'] + .module-panel {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .module-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .detail-list,
  .module-marketing {
    margin: 0;
    padding: 0.65rem 0.7rem 0.7rem;
    border-top: 1px solid rgb(17 24 39 / 0.16);
  }

  .detail-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  .detail-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.45rem;
    align-items: start;
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .detail-list li :global(svg) {
    margin-top: 0.05rem;
    color: var(--ink);
  }

  .detail-list strong,
  .detail-list span span {
    display: block;
  }

  .detail-list strong {
    color: var(--ink);
    font-weight: var(--weight-bold);
  }

  .detail-list span span {
    margin-top: 0.08rem;
  }

  .module-marketing {
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* ── Enterprise: one row per product, each opening its dialog ── */
  .product-links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgb(17 24 39 / 0.26);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.14);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 140ms var(--ease-out);
  }

  .product-link-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .product-link-name {
    font-size: 0.9375rem;
    font-weight: var(--weight-heavy);
    font-variation-settings: 'wdth' var(--wdth-caps);
    letter-spacing: 0.035em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .product-link-meta {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: var(--weight-semibold);
    font-variation-settings: 'wdth' var(--wdth-ui);
    line-height: 1.3;
    transition: color 160ms ease;
  }

  .product-link :global(svg) {
    flex: none;
    transition: transform 180ms var(--ease-out);
  }

  .product-link:active {
    transform: scale(0.99);
  }

  .product-link:focus-visible {
    outline: 2px solid var(--live);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-link:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--paper);
    }
    .product-link:hover .product-link-meta {
      color: rgb(255 255 255 / 0.72);
    }
    .product-link:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  /* The tear-off counterfoil that holds the action. */
  .counterfoil {
    margin-top: auto;
    padding-top: 1rem;
  }

  .counterfoil::before {
    content: '';
    display: block;
    margin: 0.25rem calc(-1 * var(--pad)) 0.9rem;
    border-top: 1.5px dashed var(--rule-strong);
  }

  .counterfoil .btn {
    width: 100%;
  }

  /* ── Fine print ─────────────────────────────────────────────── */
  .fine {
    display: grid;
    gap: 0.75rem;
    max-width: 92rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--cover-rule);
  }

  .every {
    max-width: 60em;
    color: var(--on-cover-2);
    font-size: 0.9375rem;
  }

  .every strong {
    color: var(--on-cover);
  }

  .fine-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: var(--on-cover-2);
    font-size: 0.9375rem;
  }

  .fine-links a {
    color: var(--on-cover);
  }

  /* ── Smaller screens: one sheet at a time, laid out across ──── */
  @media (max-width: 1080px) {
    .sheets {
      grid-template-columns: 1fr;
      max-width: 44rem;
      gap: 1.5rem;
    }
  }

  /* A wide sheet reads as a bill: name and price left, contents right. */
  @container (min-width: 34rem) {
    .rate-body {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: 2rem;
      align-items: start;
    }
    .rate-head,
    .counterfoil {
      grid-column: 1 / -1;
    }
    .price {
      grid-column: 1;
      grid-row: 2;
    }
    .includes {
      grid-column: 2;
      margin-top: 1rem;
    }
    .counterfoil .btn {
      width: auto;
    }
    /* The period sits under the figure on every wide sheet alike. */
    .amount {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 760px) {
    .bar {
      justify-content: space-between;
    }
    .billing {
      flex: 1 1 auto;
    }
    .billing label {
      flex: 1;
      justify-content: center;
    }
    .trial {
      flex: 1 1 100%;
      margin-left: 0;
    }
  }

  /* ── Desktop: the switch and all three sheets fit one screen ── */
  @media (min-width: 1081px) {
    .bar {
      margin-bottom: 1rem;
    }
    /* One row system for the set: head, price, contents and counterfoil are
       shared tracks, so each part starts at the same height on every sheet
       whatever its copy length, and the buttons line up at the foot. */
    .sheets {
      grid-template-rows: auto auto 1fr auto;
      row-gap: 0;
    }
    /* Container queries apply layout containment, which switches subgrid
       off, so on desktop the query container moves from the sheet to its
       head (where the plan name sizes itself). Desktop sheets never reach
       the 34rem bill layout, so nothing else depends on it here. */
    .rate {
      grid-row: span 4;
      display: grid;
      grid-template-rows: subgrid;
      container-type: normal;
    }
    .rate-head {
      container-type: inline-size;
    }
    .rate-body {
      grid-row: 1 / -1;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
      --pad: clamp(1rem, 1.3vw, 1.5rem);
    }
    .includes {
      align-self: start;
    }
    .counterfoil {
      margin-top: 0;
      align-self: end;
    }
    .rate-head {
      padding-bottom: 0.75rem;
    }
    /* Side by side with the audience line, the stamp overhangs the line
       instead of growing it, so every audience row is one line tall. */
    .audience-row {
      flex-wrap: nowrap;
    }
    .audience-row .stamp {
      margin-block: -0.3rem;
    }
    /* Measured against the head (sheet width less padding): 7.6cqi keeps the
       name the size it had at 7% of the sheet. */
    .rate-name {
      font-size: min(1.75rem, 7.6cqi);
    }
    .positioning {
      margin-top: 0.25rem;
      font-size: 0.875rem;
      line-height: 1.4;
    }
    /* Price, GST line and capacity badges stack the same way on every sheet. */
    .price {
      padding: 0.75rem 0;
    }
    .amount .num {
      font-size: clamp(2rem, 1.3rem + 1.4vw, 2.75rem);
    }
    .cycle {
      margin-top: 0.25rem;
    }
    .plan-limits {
      margin-top: 0.75rem;
    }
    .limit {
      font-size: 0.9375rem;
    }
    .includes {
      padding-top: 0.75rem;
    }
    /* Every module sits on its own row, so a long sheet's contents become a
       window: tall enough that the switch, the sheets and their buttons fit
       the screen, scrollable, and drifted slowly by the script below. The
       script sets --modules-window from the measured layout; the fallback
       keeps a sensible window without it. */
    .products {
      --fade: 1.5rem;
      gap: 0.65rem;
      max-height: var(--modules-window, max(12rem, calc(100svh - 32rem)));
      overflow-y: auto;
      /* No overscroll-behavior: contain. It stopped the wheel reaching the page
         whenever the pointer rested on a list, even one with nothing to scroll,
         so the page seemed frozen on desktop. A list scrolls to its end, then
         the page scrolls on. */
      scrollbar-width: thin;
      scrollbar-color: var(--rule-strong) transparent;
      scrollbar-gutter: stable;
    }
    /* A soft edge only where there is more to see. */
    .products.has-more-below {
      mask-image: linear-gradient(to bottom, #000 calc(100% - var(--fade)), transparent);
    }
    .products.has-more-above {
      mask-image: linear-gradient(to bottom, transparent, #000 var(--fade));
    }
    .products.has-more-above.has-more-below {
      mask-image: linear-gradient(
        to bottom,
        transparent,
        #000 var(--fade),
        #000 calc(100% - var(--fade)),
        transparent
      );
    }
    .product + .product {
      padding-top: 0.65rem;
    }
    .product-name {
      margin-bottom: 0.35rem;
      font-size: 0.75rem;
    }
    .module-trigger {
      min-height: 2.75rem;
      padding-block: 0.45rem;
      font-size: 0.8125rem;
    }
    .detail-list,
    .module-marketing {
      padding: 0.55rem 0.65rem 0.65rem;
    }
    .detail-list {
      gap: 0.4rem;
    }
    .detail-list li,
    .module-marketing {
      font-size: 0.75rem;
    }
    .counterfoil {
      padding-top: 0.75rem;
    }
    .counterfoil::before {
      margin: 0 calc(-1 * var(--pad)) 0.75rem;
    }
  }

  /* Narrower desktops: the longest pair of badges (Enterprise) no longer fits
     on one line, so every sheet stacks its two badges the same way. */
  @media (min-width: 1081px) and (max-width: 1399px) {
    .plan-limits {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Short laptop screens (1366×768 and the like) take one more notch in. */
  /* Desktop and laptop screens up to 960px tall (1920×1080 and shorter): the switch and all
     three sheets, buttons included, fit one screen below the navigation.
     Every sheet tightens by the same amounts, so alignment holds. */
  @media (min-width: 1081px) and (max-height: 960px) {
    .bar {
      margin-bottom: 0.75rem;
    }
    .billing label {
      min-height: 2.5rem;
    }
    .trial {
      padding: 0.3rem 1.1rem;
      gap: 0.1rem;
    }
    .trial-label {
      font-size: 0.9375rem;
    }
    .trial-line {
      font-size: 0.75rem;
    }
    .rate-body {
      --pad: 1rem;
    }
    .rate-name {
      font-size: min(1.5rem, 7.6cqi);
    }
    .rate-head {
      padding-bottom: 0.6rem;
    }
    .audience {
      font-size: 0.875rem;
    }
    .positioning {
      font-size: 0.8125rem;
      line-height: 1.35;
    }
    .price {
      padding: 0.6rem 0;
    }
    .amount .num {
      font-size: 2.25rem;
    }
    .gst-note {
      margin-top: 0.3rem;
    }
    .plan-limits {
      gap: 0.35rem;
      margin-top: 0.5rem;
    }
    .limit {
      padding: 0.2rem 0.55rem;
      font-size: 0.875rem;
    }
    .includes {
      padding-top: 0.6rem;
    }
    .products {
      gap: 0.5rem;
    }
    .product + .product {
      padding-top: 0.5rem;
    }
    .product-name {
      margin-bottom: 0.3rem;
    }
    .modules {
      gap: 0.3rem;
    }
    .module-trigger {
      min-height: 2.375rem;
      padding-block: 0.3rem;
    }
    .detail-list {
      gap: 0.35rem;
    }
    .counterfoil {
      padding-top: 0.5rem;
    }
    .counterfoil::before {
      margin: 0 calc(-1 * var(--pad)) 0.6rem;
    }
    .counterfoil .btn {
      min-height: 2.75rem;
    }
  }

  /* With the smaller badges, the pair fits one line again from 1280px. */
  @media (min-width: 1280px) and (max-width: 1399px) and (max-height: 960px) {
    .plan-limits {
      flex-direction: row;
    }
  }

  /* Laptop screens up to 800px tall (1440×900, 1536×864, 1366×768, 1280×720): one more
     notch. */
  @media (min-width: 1081px) and (max-height: 800px) {
    .bar {
      margin-bottom: 0.5rem;
    }
    .rate-body {
      --pad: 0.75rem;
    }
    .trial {
      padding-block: 0.25rem;
    }
    .rate-name {
      font-size: min(1.375rem, 7.6cqi);
    }
    .positioning {
      font-size: 0.78125rem;
      line-height: 1.3;
    }
    .price {
      padding: 0.5rem 0;
    }
    .amount .num {
      font-size: 2rem;
    }
    .module-trigger {
      min-height: 2rem;
      padding-block: 0.2rem;
    }
    .includes {
      padding-top: 0.5rem;
    }
    .counterfoil::before {
      margin-bottom: 0.5rem;
    }
    .counterfoil .btn {
      min-height: 2.5rem;
    }
  }

  /* On those short screens, where the sheet is wide enough, every sheet puts
     its badges in a fixed column beside the price instead of below it. Same
     grid on all three sheets, so price and badges still align across the set. */
  @media (min-width: 1280px) and (max-height: 800px) {
    .price {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      align-items: start;
    }
    .plan-limits {
      flex-direction: column;
      align-items: flex-end;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-link,
    .product-link :global(svg),
    .module-trigger,
    .module-trigger :global(svg),
    .module-panel {
      transition: none;
    }
  }
</style>

<script>
  function setModuleExpanded(button: HTMLButtonElement, expanded: boolean) {
    const panelId = button.getAttribute('aria-controls');
    const panel = panelId ? document.getElementById(panelId) : null;
    button.setAttribute('aria-expanded', String(expanded));
    panel?.setAttribute('aria-hidden', String(!expanded));
  }

  // ── Module window and its slow drift (desktop only) ───────────────────────
  // Each sheet's product list is a scrollable window on desktop. Where the
  // list is longer than the window, it drifts down, holds, drifts back up and
  // holds again (no duplicated items, so ids and ARIA stay unique). It holds
  // still under the pointer, while anything inside has focus, while a module
  // is open, when the sheet is off screen or the tab is hidden, and never
  // moves for reduced motion or touch-only devices.
  const desktop = matchMedia('(min-width: 1081px)');
  const keepStill = matchMedia('(prefers-reduced-motion: reduce), (hover: none)');
  const SPEED = 24; // px per second
  const HOLD = 1600; // ms at each end
  const RESUME = 800; // ms after a pause ends
  const MIN_DRIFT = 8; // px of overflow; less is not worth moving

  class ModuleMarquee {
    private pos = 0;
    private dir = 1;
    private raf = 0;
    private last = 0;
    private holdUntil = 0;
    private hovering = false;
    private focused = false;
    private open = false;
    private visible = false;

    constructor(private readonly win: HTMLElement) {
      win.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'touch') this.set('hovering', true);
      });
      win.addEventListener('pointerleave', () => this.set('hovering', false));
      // Keyboard focus only: a mouse click also focuses the button, and that
      // must not hold the window still after the visitor has moved on.
      win.addEventListener('focusin', (e) => {
        if ((e.target as Element).matches(':focus-visible')) this.set('focused', true);
      });
      win.addEventListener('focusout', (e) => {
        if (!win.contains(e.relatedTarget as Node | null)) this.set('focused', false);
      });
      win.addEventListener('scroll', () => this.edges(), { passive: true });
      new IntersectionObserver(([entry]) => this.set('visible', entry.isIntersecting)).observe(win);
      const resize = new ResizeObserver(() => this.update());
      resize.observe(win);
      win.querySelectorAll('.product').forEach((product) => resize.observe(product));
    }

    private set(key: 'hovering' | 'focused' | 'open' | 'visible', value: boolean) {
      this[key] = value;
      this.update();
    }

    private get overflowing() {
      return this.win.scrollHeight - this.win.clientHeight > MIN_DRIFT;
    }

    private get paused() {
      return (
        this.hovering ||
        this.focused ||
        this.open ||
        !this.visible ||
        document.hidden ||
        !desktop.matches ||
        keepStill.matches
      );
    }

    /** Called by the accordion when a module in this window opens or closes. */
    moduleToggled(opened: HTMLElement | null) {
      this.open = this.win.querySelector('.module-trigger[aria-expanded="true"]') !== null;
      if (opened && desktop.matches && this.overflowing) {
        const unit = opened.closest('.module-unit') ?? opened;
        const offset = unit.getBoundingClientRect().top - this.win.getBoundingClientRect().top - 4;
        this.win.scrollBy({ top: offset, behavior: keepStill.matches ? 'instant' : 'smooth' });
      }
      this.update();
    }

    update() {
      this.edges();
      if (this.paused || !this.overflowing) this.stop();
      else this.start();
    }

    private edges() {
      const { scrollTop, scrollHeight, clientHeight } = this.win;
      const scrollable = desktop.matches && scrollHeight - clientHeight > 2;
      this.win.classList.toggle('has-more-above', scrollable && scrollTop > 2);
      this.win.classList.toggle('has-more-below', scrollable && scrollTop < scrollHeight - clientHeight - 2);
    }

    private start() {
      if (this.raf) return;
      this.pos = this.win.scrollTop;
      this.last = performance.now();
      this.holdUntil = this.last + (this.pos === 0 ? HOLD : RESUME);
      this.raf = requestAnimationFrame(this.tick);
    }

    private stop() {
      cancelAnimationFrame(this.raf);
      this.raf = 0;
    }

    private tick = (now: number) => {
      const dt = Math.min(now - this.last, 64) / 1000;
      this.last = now;
      if (now >= this.holdUntil) {
        const max = this.win.scrollHeight - this.win.clientHeight;
        this.pos += this.dir * SPEED * dt;
        if (this.pos >= max) {
          this.pos = max;
          this.dir = -1;
          this.holdUntil = now + HOLD;
        } else if (this.pos <= 0) {
          this.pos = 0;
          this.dir = 1;
          this.holdUntil = now + HOLD;
        }
        this.win.scrollTop = this.pos;
      }
      this.raf = requestAnimationFrame(this.tick);
    };
  }

  const plans = document.getElementById('plans');
  const windows = [...document.querySelectorAll<HTMLElement>('.rate .products')];
  const marquees = new Map(windows.map((win) => [win, new ModuleMarquee(win)]));

  /** Size the windows so the switch, all three sheets and their buttons fit
      the screen below the navigation once a visitor jumps to the plans. */
  function sizeWindows() {
    if (!plans) return;
    if (!desktop.matches) {
      plans.style.removeProperty('--modules-window');
    } else {
      const bar = plans.querySelector('.bar');
      const buttons = [...plans.querySelectorAll('.counterfoil .btn')];
      if (!bar || buttons.length === 0) return;
      const used =
        Math.max(...buttons.map((b) => b.getBoundingClientRect().bottom)) - bar.getBoundingClientRect().top + 8;
      const rest = used - Math.max(...windows.map((w) => w.getBoundingClientRect().height));
      const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      plans.style.setProperty('--modules-window', `${Math.max(192, Math.floor(innerHeight - offset - rest))}px`);
    }
    marquees.forEach((marquee) => marquee.update());
  }

  sizeWindows();
  document.fonts?.ready.then(sizeWindows);
  addEventListener('resize', sizeWindows);
  desktop.addEventListener('change', sizeWindows);
  keepStill.addEventListener('change', sizeWindows);
  document.addEventListener('visibilitychange', () => marquees.forEach((marquee) => marquee.update()));

  document.querySelectorAll<HTMLElement>('[data-product-accordion]').forEach((product) => {
    const buttons = [...product.querySelectorAll<HTMLButtonElement>('.module-trigger')];
    const marquee = marquees.get(product.closest<HTMLElement>('.products') as HTMLElement);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const willOpen = button.getAttribute('aria-expanded') !== 'true';
        buttons.forEach((peer) => setModuleExpanded(peer, peer === button && willOpen));
        marquee?.moduleToggled(willOpen ? button : null);
      });
    });
  });
</script>
