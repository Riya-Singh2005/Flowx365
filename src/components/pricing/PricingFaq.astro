---
import Icon from '../ui/Icon.astro';
import { pricingFaqs } from '../../data/pricing';
---

<!-- Pricing questions. Native details: keyboard and screen-reader ready, no script. -->
<section class="sheet pricing-faq" id="pricing-faq" data-copy="duplicate" data-nav="light" aria-labelledby="pricing-faq-title">
  <span class="perf" aria-hidden="true" style="--hole: var(--original)"></span>
  <div class="stub" aria-hidden="true"><span class="serial">Questions</span></div>

  <div class="sheet-inner layout">
    <h2 class="display-m" id="pricing-faq-title" data-reveal="mask">Asked about plans.</h2>

    <div class="list" data-reveal style="--i: 1">
      {
        pricingFaqs.map((f) => (
          <details name="pricing-faq">
            <summary>
              <span>{f.q}</span>
              <Icon name="chevron" size={18} />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing-faq {
    position: relative;
    z-index: 1;
    padding: var(--sheet-pad) 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: start;
    max-width: 92rem;
  }

  .layout .display-m {
    font-size: var(--sheet-title);
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    max-width: 9ch;
  }

  .list {
    border-top: 2px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--rule-strong);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.25rem;
    padding: 0.6rem 0;
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    transition: transform 250ms var(--ease-out);
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  details p {
    padding: 0 0 1rem;
    max-width: 40em;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 300ms var(--ease-out),
      content-visibility 300ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  :root {
    interpolate-size: allow-keywords;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .layout .display-m {
      position: static;
      max-width: none;
    }
  }

  /* Short laptop screens: closed questions sit closer so all ten fit. */
  @media (min-width: 1024px) and (max-height: 740px) {
    summary {
      min-height: 2.75rem;
      padding-block: 0.4rem;
    }
  }
</style>
