---
import { ADDITIONAL_LICENCE_NOTICE, addOns } from '../../data/pricing';
---

<!-- Add-ons and additional capacity: possible extensions, discussed through a demo request. -->
<section class="sheet add-ons" id="add-ons" data-copy="duplicate" data-nav="light" aria-labelledby="add-ons-title">
  <span class="perf" aria-hidden="true" style="--hole: var(--cover)"></span>
  <div class="stub" aria-hidden="true"><span class="serial">Add-ons</span></div>

  <div class="sheet-inner">
    <div class="head">
      <h2 class="display-m" id="add-ons-title" data-reveal="mask">
        <span class="nowrap">Add-ons</span> and additional capacity.
      </h2>
      <div class="licence-note" data-reveal style="--i: 1">
        <h3 class="form-head">{ADDITIONAL_LICENCE_NOTICE.heading}</h3>
        <p>{ADDITIONAL_LICENCE_NOTICE.body}</p>
        <p>
          {ADDITIONAL_LICENCE_NOTICE.actionBefore}{' '}
          <strong>{ADDITIONAL_LICENCE_NOTICE.actionLabel}</strong>{' '}
          {ADDITIONAL_LICENCE_NOTICE.actionAfter}
        </p>
      </div>
    </div>

    <table class="particulars" data-reveal style="--i: 1">
      <caption class="visually-hidden">Possible add-ons and additional capacity, discussed through a demo request.</caption>
      <thead>
        <tr>
          <th scope="col">Add-on</th>
          <th scope="col">What it adds</th>
        </tr>
      </thead>
      <tbody>
        {
          addOns.map((a) => (
            <tr>
              <th scope="row" class="form-head">{a.name}</th>
              <td>{a.adds}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .add-ons {
    position: relative;
    z-index: 1;
    padding: var(--sheet-pad) 0;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: 0.75rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    max-width: 76rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .head .display-m {
    max-width: 22ch;
    font-size: var(--sheet-title);
  }

  .nowrap {
    white-space: nowrap;
  }

  .licence-note {
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
  }

  .licence-note h3 {
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .licence-note p {
    margin-top: 0.6rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .licence-note strong {
    color: var(--ink);
    font-weight: var(--weight-bold);
  }

  .particulars {
    width: 100%;
    max-width: 76rem;
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    font-size: 0.9375rem;
  }

  .particulars thead th {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--track-mono-caps);
    color: var(--ink-3);
    text-align: left;
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--rule-strong);
  }

  .particulars tbody th,
  .particulars td {
    padding: 0.75rem 1rem 0.75rem 0;
    border-bottom: 1px solid var(--rule-strong);
    text-align: left;
    vertical-align: baseline;
  }

  .particulars tbody tr:last-child > * {
    border-bottom: 0;
  }

  .particulars tbody th {
    font-size: 0.875rem;
    width: 30%;
  }

  .particulars td {
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  /* Phones: each add-on becomes a record, its name above what it adds. */
  @media (max-width: 560px) {
    .particulars thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .particulars tr {
      display: grid;
      gap: 0.25rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--rule-strong);
    }
    .particulars tbody tr:last-child {
      border-bottom: 0;
    }
    .particulars tbody th,
    .particulars td {
      display: block;
      padding: 0;
      border: 0;
      width: auto;
    }
  }

  /* Short laptop screens: tighter rows so the sheet fits one screen. */
  @media (min-width: 1024px) and (max-height: 740px) {
    .head {
      margin-bottom: 1rem;
    }
    .particulars thead th {
      padding-block: 0.5rem;
    }
    .particulars tbody th,
    .particulars td {
      padding-block: 0.5rem;
    }
  }
</style>
